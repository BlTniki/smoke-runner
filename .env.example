# Copy this file to .env for local development. Never commit real secrets.
SMOKE_RUNNER_BOT_TOKEN=replace-with-telegram-bot-token
SMOKE_RUNNER_ADMIN_TELEGRAM_USER_ID=123456789
SMOKE_RUNNER_INVITE_PEPPER=replace-with-a-long-random-secret
SMOKE_RUNNER_DATABASE_PATH=./data/smoke-runner.sqlite3

SMOKE_RUNNER_LOG_LEVEL=INFO
SMOKE_RUNNER_DEFAULT_TIMEZONE=Europe/Moscow
SMOKE_RUNNER_INVITE_TTL_HOURS=168
SMOKE_RUNNER_POLLING_CONCURRENCY_LIMIT=20
SMOKE_RUNNER_BACKUP_DIR=./data/backups
SMOKE_RUNNER_BACKUP_RETENTION_DAYS=30
